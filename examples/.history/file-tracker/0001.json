 "board": {
  "title": "File tracker",
  "option": "where are my files?",
  "prose": "A small app that keeps track of where my files are. A file is either on the laptop, ready to open, or only in cloud storage. Bringing one back needs enough free space, and the app says how much is missing when there isn't.\n\nThis is the example from the README: **v1** is the first shape, **v2** adds filtering.",
  "regions": [
   {
    "id": "R1",
    "title": "Library \u00b7 where is my file?",
    "row": 0,
    "col": 0,
    "prose": "The home of the app: every file, with where it lives right now."
   },
   {
    "id": "R2",
    "title": "Getting it back",
    "row": 0,
    "col": 1,
    "prose": "What happens when the file I want is only in the cloud."
   }
  ],
  "nodes": [
   {
    "id": "library",
